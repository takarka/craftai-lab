CRAFTAI_ENV=dev
CRAFTAI_DATABASE_URL=sqlite+aiosqlite:///./craftai_dev.db
CRAFTAI_STORAGE_DIR=./storage
CRAFTAI_JWT_SECRET=craft-ai-standalone-dev-secret-key-at-least-32-bytes-long
CRAFTAI_OPENROUTER_API_KEY=
# Lab catalog (Q-2): fill two distinct provider IDs and verified capabilities.
# Empty IDs keep draft agents usable while model execution is unavailable.
CRAFTAI_LAB_MODEL_1_ID=
CRAFTAI_LAB_MODEL_1_SUPPORTS_TOOLS=false
CRAFTAI_LAB_MODEL_1_SUPPORTS_VISION=false
CRAFTAI_LAB_MODEL_2_ID=
CRAFTAI_LAB_MODEL_2_SUPPORTS_TOOLS=false
CRAFTAI_LAB_MODEL_2_SUPPORTS_VISION=false
CRAFTAI_BRAVE_SEARCH_API_KEY=
CRAFTAI_ENABLE_EMBEDDED_WORKER=true
