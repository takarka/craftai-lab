{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Builder (Обычный запуск)",
      "preLaunchTask": "Builder: connect Android API",
      "cwd": "Builder",
      "request": "launch",
      "type": "dart",
      "noDebug": true,
      "deviceId": "af54415c",
      "args": [
        "--device-connection",
        "attached",
        "--dart-define=FIREBASE_PUSH_ENABLED=true",
        "--dart-define=APP_ENV=dev",
        "--dart-define=CRAFTAI_API_BASE_URL=https://localhost:5001"
      ]
    },
    {
      "name": "Builder (Debug режим)",
      "preLaunchTask": "Builder: connect Android API",
      "cwd": "Builder",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "deviceId": "af54415c",
      "args": [
        "--device-connection",
        "attached",
        "--dart-define=FIREBASE_PUSH_ENABLED=true",
        "--dart-define=APP_ENV=dev",
        "--dart-define=CRAFTAI_API_BASE_URL=https://localhost:5001"
      ]
    },
    {
      "name": "Builder (Demo stack, обычный запуск)",
      "preLaunchTask": "Builder: connect Android API (demo stack)",
      "cwd": "Builder",
      "request": "launch",
      "type": "dart",
      "noDebug": true,
      "deviceId": "af54415c",
      "args": [
        "--device-connection",
        "attached",
        "--dart-define=FIREBASE_PUSH_ENABLED=true",
        "--dart-define=APP_ENV=dev",
        "--dart-define=CRAFTAI_API_BASE_URL=http://localhost:8080"
      ]
    },
    {
      "name": "Builder (Demo stack, Debug режим)",
      "preLaunchTask": "Builder: connect Android API (demo stack)",
      "cwd": "Builder",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "deviceId": "af54415c",
      "args": [
        "--device-connection",
        "attached",
        "--dart-define=FIREBASE_PUSH_ENABLED=true",
        "--dart-define=APP_ENV=dev",
        "--dart-define=CRAFTAI_API_BASE_URL=http://localhost:8080"
      ]
    },
    {
      "name": "Builder (Web Chrome)",
      "cwd": "Builder",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "deviceId": "chrome",
      "args": [
        "--web-browser-flag=--ignore-certificate-errors",
        "--web-browser-flag=--disable-web-security",
        "--dart-define=APP_ENV=dev",
        "--dart-define=CRAFTAI_API_BASE_URL=https://localhost:5001"
      ]
    },
    {
      "name": "Builder (Web Chrome - без отладки)",
      "cwd": "Builder",
      "request": "launch",
      "type": "dart",
      "noDebug": true,
      "deviceId": "chrome",
      "args": [
        "--web-browser-flag=--ignore-certificate-errors",
        "--web-browser-flag=--disable-web-security",
        "--dart-define=APP_ENV=dev",
        "--dart-define=CRAFTAI_API_BASE_URL=https://localhost:5001"
      ]
    }
  ]
}
