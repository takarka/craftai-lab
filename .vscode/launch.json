  "version": "0.2.0",
  "configurations": [
    {
      "name": "Builder (Обычный запуск)",
      "cwd": "Builder",
      "request": "launch",
      "type": "dart",
      "noDebug": true,
      "deviceId": "af54415c",
      "args": [
        "--device-connection",
        "attached",
        "--dart-define=APP_ENV=dev",
        "--dart-define=CRAFTAI_API_BASE_URL=https://localhost:5001"
      ]
    },
    {
      "name": "Builder (Debug режим)",
      "cwd": "Builder",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "deviceId": "af54415c",
      "args": [
        "--device-connection",
        "attached",
        "--dart-define=APP_ENV=dev",
        "--dart-define=CRAFTAI_API_BASE_URL=https://localhost:5001"
      ]
    }
  ]
}
